# ===========================================
# BidMart Docker Compose — Central Environment
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Database Credentials ---
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=postgres
CATALOGUE_DB_USERNAME=postgres
CATALOGUE_DB_PASSWORD=postgres
WALLET_DB_USERNAME=postgres
WALLET_DB_PASSWORD=postgres

# --- Hibernate DDL ---
AUTH_DDL_AUTO=update
CATALOGUE_DDL_AUTO=update
WALLET_DDL_AUTO=update

# --- Auth Service ---
AUTH_JWT_SECRET=bidmart-auth-secret-key-bidmart-auth-secret-key
SPRING_PROFILES_ACTIVE=prod

# --- Email / SMTP (only needed when SPRING_PROFILES_ACTIVE=prod) ---
AUTH_EMAIL_VERIFICATION_BASE_URL=http://localhost:5173/verify-email
AUTH_EMAIL_VERIFICATION_FROM=no-reply@bidmart.local
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# --- Optional: External Database URLs (leave commented for local Docker DBs) ---
# AUTH_DATABASE_URL=jdbc:postgresql://your-host:5432/bidmart_auth
# CATALOGUE_DATABASE_URL=jdbc:postgresql://your-host:5432/bidmart_catalogue
# WALLET_DATABASE_URL=jdbc:postgresql://your-host:5432/bidmart_wallet_db
# AUCTION_DATABASE_URL=sqlite:///data/bidmart-auction.db

# --- Optional: Port Overrides ---
# GATEWAY_PORT=8000
# AUTH_PORT=8080
# CATALOGUE_PORT=8081
# AUCTION_PORT=8082
# WALLET_PORT=8083
# FRONTEND_PORT=80
# AUTH_DB_PORT=5434
# CATALOGUE_DB_PORT=5435
# WALLET_DB_PORT=5433
# FRONTEND_API_BASE_URL=http://localhost:8000
