# ===========================================
# BidMart Docker Compose - Central Environment
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# docker-compose.yml also reads optional per-service .env files from each
# module directory as fallbacks, but this infrastructure .env is loaded last
# and should be the single place to manage full-stack Docker values.

# --- Compose / infrastructure repo (bidmart-infrastructure) ---
COMPOSE_PROJECT_NAME=bidmart
RESTART_POLICY=unless-stopped
SWAGGER_UI_PORT=8088

# Optional image overrides for prebuilt images instead of local builds.
# GATEWAY_IMAGE=bidmart-gateway:local
# AUTH_IMAGE=bidmart-auth-service:local
# CATALOGUE_IMAGE=bidmart-catalogue-service:local
# AUCTION_IMAGE=bidmart-auction-service-rust:local
# WALLET_IMAGE=bidmart-wallet-service-rust:local
# ORDER_IMAGE=bidmart-order-and-notification-service:local
# FRONTEND_IMAGE=bidmart-frontend:local

# --- Gateway / API edge (bidmart-infrastructure) ---
GATEWAY_PORT=8000
AUTH_SERVICE_URL=http://auth-service:8080
CATALOGUE_SERVICE_URL=http://catalogue-service:8081
AUCTION_SERVICE_URL=http://auction-service:8082
WALLET_SERVICE_URL=http://wallet-service:8083
ORDER_SERVICE_URL=http://order-notification-service:8084
GATEWAY_INTERNAL_TOKEN=bidmart-local-internal-token
GATEWAY_AUTH_WS_SERVICE_URL=lb://auth-service
GATEWAY_ORDER_WS_SERVICE_URL=lb://order-notification-service
GATEWAY_AUTH_SERVICE_URL=lb://auth-service
GATEWAY_CATALOGUE_SERVICE_URL=lb://catalogue-service
GATEWAY_AUCTION_SERVICE_URL=lb://auction-service
GATEWAY_WALLET_SERVICE_URL=lb://wallet-service
GATEWAY_ORDER_SERVICE_URL=lb://order-notification-service
GATEWAY_RATE_LIMIT_MAX_ATTEMPTS=20
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_SERVICE_INSTANCE_0=http://auth-service:8080
CATALOGUE_SERVICE_INSTANCE_0=http://catalogue-service:8081
AUCTION_SERVICE_INSTANCE_0=http://auction-service:8082
WALLET_SERVICE_INSTANCE_0=http://wallet-service:8083
ORDER_SERVICE_INSTANCE_0=http://order-notification-service:8084

# Heroku gateway production wiring, once gateway is deployed:
# AUTH_SERVICE_URL=https://bidmart-authentication-service-5f40f293e67d.herokuapp.com
# AUCTION_SERVICE_URL=https://bidmart-auction-service-c30c7668b800.herokuapp.com
# CATALOGUE_SERVICE_URL=<live catalogue Heroku URL>
# WALLET_SERVICE_URL=<live wallet Heroku URL>
# ORDER_SERVICE_URL=<live order/notification Heroku URL>

# --- Supabase database notes ---
# For Heroku production, set each service's database config vars in Heroku to
# Supabase Postgres credentials. Supabase JDBC examples:
#   jdbc:postgresql://<supabase-host>:5432/postgres?sslmode=require
# Supabase Rust/Postgres URL example:
#   postgresql://postgres.<project-ref>:<password>@<supabase-host>:5432/postgres?sslmode=require

# --- Auth service repo (../bidmart-auth-service) ---
AUTH_PORT=8080
AUTH_DB_PORT=5434
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=postgres
# Heroku/Supabase override example:
# AUTH_DATABASE_URL=jdbc:postgresql://<supabase-host>:5432/postgres?sslmode=require
AUTH_DATABASE_URL=jdbc:postgresql://auth-db:5432/bidmart_auth
AUTH_DDL_AUTO=update
AUTH_JWT_SECRET=bidmart-auth-secret-key-bidmart-auth-secret-key
AUTH_JWT_ACCESS_TTL_SECONDS=1800
AUTH_JWT_REFRESH_TTL_SECONDS=1800
SPRING_PROFILES_ACTIVE=prod

# Auth email verification and SMTP sender.
AUTH_EMAIL_VERIFICATION_BASE_URL=http://localhost/verify-email
AUTH_EMAIL_VERIFICATION_FROM=no-reply@bidmart.local
AUTH_EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
AUTH_EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
AUTH_PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Auth OAuth is also passed to the frontend build.
OAUTH_GOOGLE_CLIENT_ID=

# Auth wallet-provisioning outbox.
AUTH_WALLET_PROVISIONING_SOURCE=bidmart-auth-service
AUTH_WALLET_PROVISIONING_EXCHANGE=bidmart.wallet.provisioning
AUTH_WALLET_PROVISIONING_ROUTING_KEY=wallet.provision.requested.v1
AUTH_WALLET_PROVISIONING_OUTBOX_PUBLISH_DELAY_MS=5000
AUTH_WALLET_PROVISIONING_OUTBOX_BATCH_SIZE=50
AUTH_WALLET_PROVISIONING_OUTBOX_MAX_ATTEMPTS=10
AUTH_WALLET_PROVISIONING_OUTBOX_RETRY_BASE_SECONDS=30
AUTH_WALLET_PROVISIONING_OUTBOX_RETRY_MAX_SECONDS=900

# --- Catalogue service repo (../bidmart-catalogue-service) ---
CATALOGUE_PORT=8081
CATALOGUE_DB_PORT=5435
CATALOGUE_DB_USERNAME=postgres
CATALOGUE_DB_PASSWORD=postgres
# Heroku/Supabase override example:
# CATALOGUE_DATABASE_URL=jdbc:postgresql://<supabase-host>:5432/postgres?sslmode=require
CATALOGUE_DATABASE_URL=jdbc:postgresql://catalogue-db:5432/bidmart_catalogue
CATALOGUE_DDL_AUTO=update
CATALOGUE_AUCTION_EVENTS_QUEUE=catalogue.auction-events
BIDMART_JWT_SECRET=bidmart-auth-secret-key-bidmart-auth-secret-key

# --- Auction service repo (../bidmart-auction-service-rust) ---
AUCTION_PORT=8082
AUCTION_DB_PORT=5436
AUCTION_DB_USERNAME=postgres
AUCTION_DB_PASSWORD=postgres
# Heroku/Supabase override example:
# AUCTION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<supabase-host>:5432/postgres?sslmode=require
AUCTION_DATABASE_URL=postgresql://postgres:postgres@auction-db:5432/bidmart_auction
AUCTION_CLOSURE_SCHEDULER_INTERVAL_MS=1000
OUTBOX_SCHEDULER_INTERVAL_MS=1000
BIND_ADDRESS=0.0.0.0:8082
CATALOGUE_GRPC_URL=http://catalogue-service:9091
WALLET_GRPC_URL=http://wallet-service:50051

# --- Wallet service repo (../bidmart-wallet-service-rust) ---
WALLET_PORT=8083
WALLET_DB_PORT=5433
WALLET_DB_USERNAME=postgres
WALLET_DB_PASSWORD=postgres
# Heroku/Supabase override example:
# WALLET_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<supabase-host>:5432/postgres?sslmode=require
WALLET_DATABASE_URL=postgresql://postgres:postgres@wallet-db:5432/bidmart_wallet_db
# Legacy Java wallet service only; ignored by bidmart-wallet-service-rust.
WALLET_DDL_AUTO=update
# Wallet uses this public frontend URL for payment redirects.
FRONTEND_BASE_URL=http://localhost
WALLET_AUCTION_SERVICE_BASE_URL=http://auction-service:8082/api/v1/auctions

# Wallet Midtrans sandbox.
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_SANDBOX_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_CHARGE_URL=https://api.sandbox.midtrans.com/v2/charge
MIDTRANS_STATUS_BASE_URL=https://api.sandbox.midtrans.com/v2
MIDTRANS_BCA_VA_SIMULATOR_URL=https://simulator.sandbox.midtrans.com/bca/va/index
MIDTRANS_BNI_VA_SIMULATOR_URL=https://simulator.sandbox.midtrans.com/bni/va/index
MIDTRANS_BRI_VA_SIMULATOR_URL=https://simulator.sandbox.midtrans.com/bri/va/index
MIDTRANS_PERMATA_VA_SIMULATOR_URL=https://simulator.sandbox.midtrans.com/openapi/va/index
MIDTRANS_MANDIRI_BILL_SIMULATOR_URL=https://simulator.sandbox.midtrans.com/openapi/mandiri/index
MIDTRANS_QRIS_SIMULATOR_URL=https://simulator.sandbox.midtrans.com/qris/index
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/v1/transactions

# --- Order and notification service repo (../bidmart-order-and-notification-service) ---
ORDER_PORT=8084
ORDER_DB_PORT=5437
ORDER_DB_USERNAME=postgres
ORDER_DB_PASSWORD=postgres
# Heroku/Supabase override example:
# ORDER_DATABASE_URL=jdbc:postgresql://<supabase-host>:5432/postgres?sslmode=require
ORDER_DATABASE_URL=jdbc:postgresql://order-db:5432/bidmart_order
ORDER_DDL_AUTO=update
DATABASE_URL=jdbc:postgresql://order-db:5432/bidmart_order
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
ORDER_AUCTION_EVENTS_QUEUE=order-notification.auction-events
ORDER_AUTH_EVENTS_QUEUE=order-notification.auth-events
ORDER_PAYOUT_DELAY_MINUTES=5
ORDER_PAYOUT_SCHEDULER_INTERVAL_MS=60000

# --- Frontend repo (../bidmart-frontend) ---
# Docker Compose serves Vite for hot reload on 5173 by default.
FRONTEND_PORT=5173
FRONTEND_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=
FRONTEND_CHOKIDAR_USEPOLLING=true
FRONTEND_WATCHPACK_POLLING=true
# Vercel production frontend:
# https://bidmart-frontend.vercel.app
# Set VITE_API_BASE_URL / FRONTEND_API_BASE_URL to the live gateway URL once gateway is ready.

# --- Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- RabbitMQ dependency (shared by auth, catalogue, auction, wallet, order) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2f
BIDMART_EVENTS_EXCHANGE=bidmart.events

# --- Redis dependency (auth-service) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2000
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=0
