// Optional Grafana Alloy: remote_write to Grafana Cloud.
// Scrape: VPS gateway (staging + prod) + Heroku auth/order (container apps).
// Export GRAFANA_CLOUD_* and METRICS_BASIC_USER / METRICS_BASIC_PASSWORD.

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = env("GRAFANA_CLOUD_PROMETHEUS_URL")

    basic_auth {
      username = env("GRAFANA_CLOUD_PROMETHEUS_USER")
      password = env("GRAFANA_CLOUD_API_KEY")
    }
  }
}

prometheus.scrape "gateway_staging" {
  targets = [{
    __address__ = "bidmart-staging.43.157.208.68.sslip.io:443",
    job         = "bidmart-gateway-staging",
  }]
  scheme       = "https"
  metrics_path = "/actuator/prometheus"
  basic_auth {
    username = env("METRICS_BASIC_USER")
    password = env("METRICS_BASIC_PASSWORD")
  }
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "gateway_prod" {
  targets = [{
    __address__ = "bidmart-prod.43.157.208.68.sslip.io:443",
    job         = "bidmart-gateway-prod",
