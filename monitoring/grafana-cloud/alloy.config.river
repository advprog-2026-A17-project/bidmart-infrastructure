// Optional Grafana Alloy config: scrape Heroku BidMart metrics and remote_write to Grafana Cloud.
// 1. Export GRAFANA_CLOUD_* from Grafana Cloud → Prometheus → Details.
// 2. Export METRICS_BASIC_USER / METRICS_BASIC_PASSWORD (same as Heroku apps).
// 3. Run: alloy run monitoring/grafana-cloud/alloy.config.river

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = env("GRAFANA_CLOUD_PROMETHEUS_URL")

    basic_auth {
      username = env("GRAFANA_CLOUD_PROMETHEUS_USER")
      password = env("GRAFANA_CLOUD_API_KEY")
    }
  }
}

prometheus.scrape "gateway" {
  targets = [{
    __address__ = "bidmart-infrastructure-1e27e116dbce.herokuapp.com:443",
    job         = "bidmart-gateway",
  }]
  scheme        = "https"
  metrics_path  = "/actuator/prometheus"
  basic_auth {
    username = env("METRICS_BASIC_USER")
    password = env("METRICS_BASIC_PASSWORD")
  }
  forward_to    = [prometheus.remote_write.grafana_cloud.receiver]
}

