# Copy to /etc/bidmart/staging.env on the VPS and fill secrets there.
# Do not commit real secrets. Format: KEY=VALUE (no quotes, no spaces around =).
# Loaded by deploy/vps/deploy.sh after `scp` into bidmart-infrastructure/.env.

# ===== Compose / ports =====
COMPOSE_PROJECT_NAME=bidmart-staging
# Edge Caddy is mapped to host port 8443 because VPS sshd owns 443.
BIDMART_PUBLIC_HOST=https://bidmart-staging.43.157.208.68.sslip.io:8443
RESTART_POLICY=unless-stopped

GATEWAY_PORT=127.0.0.1:18000
SWAGGER_UI_PORT=127.0.0.1:18088
PROMETHEUS_PORT=127.0.0.1:19090
GRAFANA_PORT=127.0.0.1:13001
RABBITMQ_HOST_PORT=127.0.0.1:15672
RABBITMQ_MANAGEMENT_HOST_PORT=127.0.0.1:25672
REDIS_HOST_PORT=127.0.0.1:16379

# ===== Service URLs (gateway routing) =====
# Auth and order run on Heroku; catalogue/auction/wallet on VPS docker network.
AUTH_SERVICE_INSTANCE_0=https://bidmart-auth-staging-392ed0eda7b8.herokuapp.com
ORDER_SERVICE_INSTANCE_0=https://bidmart-order-staging-a5fd01b90144.herokuapp.com
CATALOGUE_SERVICE_URL=http://catalogue-service:8081
AUCTION_SERVICE_URL=http://auction-service:8082
WALLET_SERVICE_URL=http://wallet-service:8083
GATEWAY_AUTH_SERVICE_URL=https://bidmart-auth-staging-392ed0eda7b8.herokuapp.com
GATEWAY_CATALOGUE_SERVICE_URL=http://catalogue-service:8081
GATEWAY_AUCTION_SERVICE_URL=http://auction-service:8082
GATEWAY_WALLET_SERVICE_URL=http://wallet-service:8083
GATEWAY_ORDER_SERVICE_URL=https://bidmart-order-staging-a5fd01b90144.herokuapp.com
GATEWAY_AUTH_WS_SERVICE_URL=https://bidmart-auth-staging-392ed0eda7b8.herokuapp.com
GATEWAY_ORDER_WS_SERVICE_URL=https://bidmart-order-staging-a5fd01b90144.herokuapp.com

CATALOGUE_GRPC_URL=http://catalogue-service:9091
WALLET_GRPC_URL=http://wallet-service:50051

FRONTEND_BASE_URL=https://bidmart-frontend.vercel.app
BIDMART_AUTH_BASE_URL=https://bidmart-auth-staging-392ed0eda7b8.herokuapp.com
BIDMART_ORDER_PUBLIC_URL=https://bidmart-order-staging-a5fd01b90144.herokuapp.com

# ===== Metrics / Grafana Cloud scrape auth =====
METRICS_BASIC_USER=grafana
METRICS_BASIC_PASSWORD=replace-with-strong-staging-password

# ===== Shared secrets (must match Heroku auth/order config) =====
AUTH_JWT_SECRET=replace-with-strong-staging-jwt-secret
GATEWAY_INTERNAL_TOKEN=replace-with-strong-staging-internal-token
AUTH_INTERNAL_SERVICE_TOKEN=replace-with-strong-staging-internal-token

# ===== Spring profiles =====
SPRING_PROFILES_ACTIVE=prod
AUTH_DDL_AUTO=update
CATALOGUE_DDL_AUTO=update
ORDER_DDL_AUTO=update

# ===== Supabase (VPS services) =====
# Use Session Pooler (IPv4, port 5432) if direct connection fails on IPv6-only host.
# Catalogue (jdbc — Spring Boot):
CATALOGUE_DATABASE_URL=jdbc:postgresql://db.mekfvqtoeuwjiafltier.supabase.co:5432/postgres?sslmode=require
CATALOGUE_DB_USERNAME=postgres
CATALOGUE_DB_PASSWORD=replace-with-catalogue-supabase-password
# Auction (Rust sqlx):
AUCTION_DATABASE_URL=postgresql://postgres:replace-with-auction-supabase-password@db.begunupzsnlftbsdgmxw.supabase.co:5432/postgres?sslmode=require
# Wallet (Rust sqlx):
WALLET_DATABASE_URL=postgresql://postgres:replace-with-wallet-supabase-password@db.pctktjwzbmoiftvkersb.supabase.co:5432/postgres?sslmode=require

# ===== CloudAMQP (shared with Heroku auth/order CLOUDAMQP_URL) =====
RABBITMQ_URL=amqps://replace-with-cloudamqp-url
SPRING_RABBITMQ_URL=amqps://replace-with-cloudamqp-url

# ===== Midtrans (wallet payments — sandbox or production) =====
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IRIS_API_KEY=
MIDTRANS_IRIS_MERCHANT_KEY=
MIDTRANS_SANDBOX_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_CHARGE_URL=https://api.sandbox.midtrans.com/v2/charge
MIDTRANS_STATUS_BASE_URL=https://api.sandbox.midtrans.com/v2
MIDTRANS_BCA_VA_SIMULATOR_URL=https://simulator.sandbox.midtrans.com/bca/va/index
MIDTRANS_BNI_VA_SIMULATOR_URL=https://simulator.sandbox.midtrans.com/bni/va/index
MIDTRANS_BRI_VA_SIMULATOR_URL=https://simulator.sandbox.midtrans.com/bri/va/index
MIDTRANS_PERMATA_VA_SIMULATOR_URL=https://simulator.sandbox.midtrans.com/openapi/va/index
MIDTRANS_MANDIRI_BILL_SIMULATOR_URL=https://simulator.sandbox.midtrans.com/openapi/mandiri/index
