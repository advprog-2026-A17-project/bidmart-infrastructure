# =============================================================================
# /etc/bidmart/grafana-cloud.env — Alloy agent credentials.
# Copy to /etc/bidmart/grafana-cloud.env and chmod 600. NOT in git.
#
# Retrieve values from grafana.com/orgs/<your-org> -> select stack:
#   1. Open the stack -> "Send Metrics" card -> Prometheus tab.
#      - GRAFANA_CLOUD_PROMETHEUS_URL  -> "Remote Write Endpoint"
#      - GRAFANA_CLOUD_PROMETHEUS_USER -> "Username / Instance ID" (numeric)
#   2. Open the stack -> "Send Logs" card -> Loki tab.
#      - GRAFANA_CLOUD_LOKI_URL  -> "Remote Write Endpoint"
#      - GRAFANA_CLOUD_LOKI_USER -> "User"
#   3. Create one Access Policy token with scopes:
#        metrics:write, logs:write, traces:write (last is optional)
#      Use the generated token for GRAFANA_CLOUD_API_KEY (single token for all signals).
# =============================================================================

GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-XX-prod-region.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USER=replace-with-numeric-instance-id

GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=replace-with-numeric-instance-id

# Single Access Policy token used as the basic-auth password for BOTH endpoints.
GRAFANA_CLOUD_API_KEY=replace-with-glc_xxx-token

# These MUST match the values currently set on every Heroku app and the VPS
# /etc/bidmart/{staging,prod}.env. Alloy uses them to authenticate to
# /actuator/prometheus.
METRICS_BASIC_USER=grafana
METRICS_BASIC_PASSWORD=replace-with-same-password-as-heroku-and-vps
