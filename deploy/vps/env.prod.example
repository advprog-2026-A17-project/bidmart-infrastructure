# Copy to /etc/bidmart/prod.env on the VPS and fill secrets there.
# Do not commit real secrets.

COMPOSE_PROJECT_NAME=bidmart-prod
BIDMART_PUBLIC_HOST=https://bidmart-prod.43.157.208.68.sslip.io

GATEWAY_PORT=127.0.0.1:28000
SWAGGER_UI_PORT=127.0.0.1:28088
PROMETHEUS_PORT=127.0.0.1:29090
GRAFANA_PORT=127.0.0.1:23001
AUTH_DB_PORT=127.0.0.1:25434
CATALOGUE_DB_PORT=127.0.0.1:25435
AUCTION_DB_PORT=127.0.0.1:25436
WALLET_DB_PORT=127.0.0.1:25433
ORDER_DB_PORT=127.0.0.1:25437
RABBITMQ_PORT=5672
RABBITMQ_HOST_PORT=127.0.0.1:25673
RABBITMQ_MANAGEMENT_HOST_PORT=127.0.0.1:35672
REDIS_PORT=6379
REDIS_HOST_PORT=127.0.0.1:26379

AUTH_SERVICE_URL=http://auth-service:8080
CATALOGUE_SERVICE_URL=http://catalogue-service:8081
AUCTION_SERVICE_URL=http://auction-service:8082
WALLET_SERVICE_URL=http://wallet-service:8083
ORDER_SERVICE_URL=http://order-notification-service:8084
GATEWAY_AUTH_SERVICE_URL=http://auth-service:8080
GATEWAY_CATALOGUE_SERVICE_URL=http://catalogue-service:8081
GATEWAY_AUCTION_SERVICE_URL=http://auction-service:8082
GATEWAY_WALLET_SERVICE_URL=http://wallet-service:8083
GATEWAY_ORDER_SERVICE_URL=http://order-notification-service:8084
GATEWAY_AUTH_WS_SERVICE_URL=http://auth-service:8080
GATEWAY_ORDER_WS_SERVICE_URL=http://order-notification-service:8084

CATALOGUE_GRPC_URL=http://catalogue-service:9091
WALLET_GRPC_URL=http://wallet-service:50051

FRONTEND_BASE_URL=https://bidmart-frontend.vercel.app
METRICS_BASIC_USER=grafana
METRICS_BASIC_PASSWORD=replace-with-strong-prod-password

AUTH_JWT_SECRET=replace-with-strong-prod-jwt-secret
GATEWAY_INTERNAL_TOKEN=replace-with-strong-prod-internal-token
AUTH_INTERNAL_SERVICE_TOKEN=replace-with-strong-prod-internal-token

SPRING_PROFILES_ACTIVE=prod
AUTH_DDL_AUTO=update
CATALOGUE_DDL_AUTO=update
ORDER_DDL_AUTO=update

AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=replace-with-prod-auth-db-password
CATALOGUE_DB_USERNAME=postgres
CATALOGUE_DB_PASSWORD=replace-with-prod-catalogue-db-password
AUCTION_DB_USERNAME=postgres
AUCTION_DB_PASSWORD=replace-with-prod-auction-db-password
AUCTION_DATABASE_URL=postgresql://postgres:replace-with-prod-auction-db-password@auction-db:5432/bidmart_auction
WALLET_DB_USERNAME=postgres
WALLET_DB_PASSWORD=replace-with-prod-wallet-db-password
WALLET_DATABASE_URL=postgresql://postgres:replace-with-prod-wallet-db-password@wallet-db:5432/bidmart_wallet_db
ORDER_DB_USERNAME=postgres
ORDER_DB_PASSWORD=replace-with-prod-order-db-password

RABBITMQ_USERNAME=bidmart
RABBITMQ_PASSWORD=replace-with-prod-rabbit-password
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_URL=amqp://bidmart:replace-with-prod-rabbit-password@rabbitmq:5672/%2f
SPRING_RABBITMQ_VIRTUAL_HOST=/
REDIS_PASSWORD=

MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IRIS_API_KEY=
MIDTRANS_IRIS_MERCHANT_KEY=
OAUTH_GOOGLE_CLIENT_ID=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
